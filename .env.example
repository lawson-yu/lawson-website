# 本地开发使用这份模板：复制为 .env 后按需修改。
# 生产环境的变量放在服务器上的 .env.production，不提交到仓库。

# 应用连接数据库的地址。本机开发时指向 compose 暴露的 5432 端口。
DATABASE_URL="postgresql://lawson:lawson@localhost:5432/lawson_website?schema=public"

# compose 中 PostgreSQL 容器的初始化参数。
POSTGRES_USER=lawson
POSTGRES_PASSWORD=lawson
POSTGRES_DB=lawson_website

# 本地开发用的 Mailpit 端口。若 1025 已被其他项目占用，改这里的 SMTP 端口并同步调整 SMTP_PORT。
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 邮件发送。开发环境指向 Mailpit；生产环境的 SMTP 服务商待定。
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
