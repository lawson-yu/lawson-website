# 本地开发使用这份模板：复制为 .env 后按需修改。
# 生产环境的变量放在服务器上的 .env.production，不提交到仓库。

# 应用连接数据库的地址。本机开发时指向 compose 暴露的 5432 端口。
DATABASE_URL="postgresql://lawson:lawson@localhost:5432/lawson_website?schema=public"

# Google OAuth 本地回调为 http://localhost:3000/api/auth/callback/google。
# 同一个 Google OAuth 客户端可登记本地与正式环境回调地址。
BETTER_AUTH_URL="http://localhost:3000"
# 用 openssl rand -base64 32 生成至少 32 字节的随机密钥。
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS=""

# compose 中 PostgreSQL 容器的初始化参数。
POSTGRES_USER=lawson
POSTGRES_PASSWORD=lawson
POSTGRES_DB=lawson_website

# 本地开发用的 Mailpit 端口。若 1025 已被其他项目占用，改这里的 SMTP 端口并同步调整 SMTP_PORT。
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 邮件发送。开发环境指向 Mailpit；生产环境的 SMTP 服务商待定。
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# 站点公开地址与媒体存储（本地默认 local，写入 public/uploads/）。
SITE_URL="http://localhost:3000"
MEDIA_DRIVER=local
MEDIA_PUBLIC_BASE_URL=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="na-siliconvalley"
COS_MEDIA_PREFIX="media"
