# 生产环境模板：复制为服务器上的 .env.production，并填入真实值。
# 这个文件不要提交真实密钥。

# 站点域名。留空时 Caddy 只监听 80 端口，可用服务器 IP 验证部署。
# 域名解析到服务器后填入该域名，Caddy 会自动申请并续期 HTTPS 证书。
APP_DOMAIN=

# 应用连接数据库的地址。容器内通过服务名 postgres 访问，不要用 localhost。
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/lawson_website?schema=public"

# Google OAuth 正式回调为 https://lawson-codes.dev/api/auth/callback/google。
BETTER_AUTH_URL=https://lawson-codes.dev
# 用 openssl rand -base64 32 生成至少 32 字节的随机密钥。
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Next.js Server Actions 加密密钥；构建和运行时必须保持一致。
# 用 openssl rand -base64 32 生成。
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# compose 中 PostgreSQL 容器的初始化参数。
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lawson_website

# 生产邮件发送。服务商待定，接入前登录链接不会真正发信。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 站点公开地址与腾讯云硅谷 COS 媒体配置。
SITE_URL=https://lawson-codes.dev
MEDIA_DRIVER=cos
MEDIA_PUBLIC_BASE_URL=https://media.lawson-codes.dev
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=na-siliconvalley
COS_MEDIA_PREFIX=media
